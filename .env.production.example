# Production settings for the Buiry server image. Names only: real values live in AWS Secrets Manager (see
# infra/aws, secret_names) or the task definition, never in a file. The server refuses to start in production
# when a required value is missing or weak (packages/api/src/config-check.ts).

NODE_ENV=production
PORT=8787
# api (HTTP behind the load balancer), worker (background jobs) or all
BUIRY_ROLE=

# Required. RDS Postgres with TLS, e.g. postgres://user:password@host:5432/buiry?sslmode=require (from Secrets Manager)
DATABASE_URL=
# Required. At least 32 random characters (e.g. openssl rand -base64 48). Rotating it requires re-sealing stored
# delegate keys and webhook secrets first (docs/KEY_CUSTODY.md).
BUIRY_SECRET_KEY=
# Proxies in front of the server that append to X-Forwarded-For. 0 (default) uses the socket address and ignores
# the header; 1 behind one AWS ALB. Never higher than the real number of proxies: extra hops let clients pick their
# own address for rate limits.
BUIRY_TRUSTED_PROXY_HOPS=1
# Days until a new agent token expires (default 90; 0 = no expiry). Rotation revokes the old token at once.
BUIRY_AGENT_TOKEN_MAX_DAYS=
# Optional: open live streams per user and per project, per API task (defaults 5 and 50)
BUIRY_SSE_MAX_PER_USER=
BUIRY_SSE_MAX_PER_PROJECT=
# Required. https only.
BUIRY_BASE_URL=
BUIRY_ALLOWED_ORIGINS=

# Managed Walrus Memory account (all three, or none if every project brings its own account)
WALRUS_NETWORK=
WALRUS_RELAYER_URL=
WALRUS_ACCOUNT_ID=
WALRUS_DELEGATE_KEY=
# Tatum Sui gateway
TATUM_NETWORK=
TATUM_API_KEY=
TATUM_GRPC_ENDPOINT=

# Email sign-in: smtp, or off to disable email sign-in
BUIRY_MAILER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional OAuth (id and secret together)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional behaviour
BUIRY_RENEWAL=
BUIRY_MANAGED_WORKSPACE_ID=
BUIRY_MANAGED_MULTI_TENANT=
# Set only for a deliberate migrate-on-start (default: the migration task applies migrations)
BUIRY_MIGRATE_ON_START=
