# One backup run (docs/DEPLOY_ORACLE.md, step 5). DESIGNED ONLY: not run on Oracle.
# Install as /etc/systemd/system/buiry-backup.service, with buiry-backup.timer.

[Unit]
Description=Buiry database backup (pg_dump, local and off-box)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=buiry-backup
Group=buiry-backup
EnvironmentFile=/etc/buiry/backup.env
ExecStart=/bin/bash /opt/buiry/src/infra/oracle/backup-local.sh
NoNewPrivileges=yes
PrivateTmp=yes
