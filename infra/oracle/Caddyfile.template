# Caddy in front of Buiry on one VM (docs/DEPLOY_ORACLE.md, step 4). DESIGNED ONLY: not run on Oracle.
# Install as /etc/caddy/Caddyfile. Set BUIRY_DOMAIN in Caddy's own environment to the preview's domain (the host of
# BUIRY_BASE_URL); no real hostname is written here. Caddy obtains the certificate and redirects HTTP to HTTPS itself.
#
# No `log` directive on purpose: sign-in links carry a one-time token in the URL, and an access log would write it
# to disk. Errors still go to the journal (`journalctl -u caddy`).

{$BUIRY_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787 {
		# Live updates are a server-sent event stream: pass each event through at once.
		flush_interval -1
	}
}
