# Nightly backup (docs/DEPLOY_ORACLE.md, step 5). DESIGNED ONLY: not run on Oracle.
# Install as /etc/systemd/system/buiry-backup.timer, then: systemctl enable --now buiry-backup.timer

[Unit]
Description=Nightly Buiry database backup

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
