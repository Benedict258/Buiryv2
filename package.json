{
  "name": "buiry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build && pnpm --filter @buiry/dashboard build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/dashboard/tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "conformance": "tsx scripts/conformance.ts",
    "demo": "tsx scripts/demo/run.ts",
    "dev:api": "tsx scripts/dev-server.ts",
    "dev:dashboard": "pnpm --filter @buiry/dashboard dev",
    "dashboard:shots": "tsx scripts/dashboard-shots.ts",
    "release:pack": "tsx scripts/release/pack.ts --dry-run",
    "release:smoke": "tsx scripts/release/smoke.ts",
    "secret-guard": "tsx scripts/secret-guard.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.0.0",
    "fast-check": "^3.22.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.3.0",
    "tsup": "9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "hono@>=4.0.0 <4.13.16": "4.13.16",
      "@hono/node-server@>=2.0.0 <2.1.6": "2.1.6"
    }
  }
}
