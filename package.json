{
  "name": "buiry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build && pnpm --filter @buiry/dashboard build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @buiry/dashboard typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "conformance": "tsx scripts/conformance.ts",
    "demo": "tsx scripts/demo/run.ts",
    "dev:api": "DASHBOARD_DIR=apps/dashboard/dist tsx scripts/dev-server.ts",
    "dev:dashboard": "pnpm --filter @buiry/dashboard dev",
    "dashboard:shots": "tsx scripts/dashboard-shots.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.22.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0",
    "zod": "^4.6.7"
  }
}
