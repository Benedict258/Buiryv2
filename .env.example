# Names only. Copy to .env (gitignored) and fill in values there; never commit .env.

# Walrus Memory relayer
WALRUS_RELAYER_URL=
WALRUS_NETWORK=mainnet
WALRUS_ACCOUNT_ID=
# Delegate PRIVATE key (64 hex characters or suiprivkey1...), not the public key.
WALRUS_DELEGATE_KEY=

# Tatum (Sui over gRPC only)
TATUM_API_KEY=
TATUM_NETWORK=mainnet
# Endpoints are taken from Tatum's docs (never defaulted in code). host:port for gRPC.
TATUM_GRPC_ENDPOINT=
# Leave unset: Tatum does not serve Sui JSON-RPC (A8). Setting it adds the JSON-RPC backend as a fallback.
TATUM_JSONRPC_URL=
# Optional: requests per second for the gateway token bucket (default 3).
TATUM_FREE_RPS=

# Server
DATABASE_URL=
# 32+ byte secret used to hash agent tokens and sign sessions/webhooks
BUIRY_SECRET_KEY=
BUIRY_BASE_URL=
# Comma-separated origins allowed for cookie-authenticated writes
BUIRY_ALLOWED_ORIGINS=
# Unset or "console": print sign-in links to the server log (development only; never in production, where email sign-in is refused until a mailer is configured). "memory": in-process (tests only)
BUIRY_MAILER=
# Only during a BUIRY_SECRET_KEY rotation: the previous key (see docs/KEY_CUSTODY.md)
BUIRY_SECRET_KEY_PREVIOUS=
# Proxies that append to X-Forwarded-For (0 = ignore the header, use the socket address; 1 behind one load balancer)
BUIRY_TRUSTED_PROXY_HOPS=
# Open live activity streams allowed per user and per project, per server process (defaults 5 and 50)
BUIRY_SSE_MAX_PER_USER=
# Days until a new agent token expires (server default 90; 0 = no expiry)
BUIRY_AGENT_TOKEN_MAX_DAYS=
# Items allowed in one pack preview or import (default 500)
BUIRY_PACK_MAX_ITEMS=
BUIRY_SSE_MAX_PER_PROJECT=
# BUIRY_MAILER=smtp: SMTP_HOST and SMTP_FROM required. SMTP_SECURE=true for implicit TLS (port 465); otherwise
# STARTTLS is required (always in production; SMTP_REQUIRE_TLS=0 allowed only outside production).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=
# "on": memories close to expiry are written again before they lapse (renewal by rewrite). Default off.
BUIRY_RENEWAL=
# Managed Walrus account tenancy: it serves one workspace (this id, or the first to write). "1" lets every workspace share it.
BUIRY_MANAGED_WORKSPACE_ID=
# Preview mode (testers bring their own Walrus testnet accounts): BUIRY_PREVIEW=1 needs BUIRY_MANAGED=off and refuses
# BUIRY_MANAGED_MULTI_TENANT=1 and BUIRY_MANAGED_WORKSPACE_ID, in every environment.
BUIRY_PREVIEW=
BUIRY_MANAGED_MULTI_TENANT=
# Most per-project (bring-your-own) Walrus adapters kept in memory (default 100)
BUIRY_BYO_ADAPTER_CACHE=
# Development only: allow a project's own relayer on localhost or a private address (ignored in production)
BUIRY_BYO_ALLOW_PRIVATE=
# Live check L-BYO1 only (in .env.testnet): a second testnet Walrus Memory account
WALRUS_BYO_TEST_RELAYER_URL=
WALRUS_BYO_TEST_ACCOUNT_ID=
WALRUS_BYO_TEST_DELEGATE_KEY=
# "off" disables plan limits (self-hosting)
BUIRY_ENTITLEMENTS=
# Serve the built dashboard, e.g. apps/dashboard/dist
DASHBOARD_DIR=
PORT=
NODE_ENV=

# OAuth sign-in (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CLI and MCP client
BUIRY_API_URL=
BUIRY_TOKEN=
# JSON array overriding the command `buiry connect` writes, e.g. ["node","<repo>/packages/mcp/dist/bin.js"]
BUIRY_MCP_COMMAND=

# Scripts (optional)
DEMO_PACKAGE_ID=
DEMO_TX_DIGEST=
DEMO_NETWORK=
VALID_UNTIL=
BUIRY_CONTRACT_RELAYER_URL=
SMOKE_TX=
SMOKE_OBJECT=
SMOKE_PACKAGE=
CHROMIUM_PATH=
DASHBOARD_URL=
# Dashboard dev server (Vite) proxy target for /v1, default http://localhost:8787
BUIRY_API=
