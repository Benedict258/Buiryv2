# Names only. Copy to .env (gitignored) and fill in values there; never commit .env.

# Walrus Memory relayer
WALRUS_RELAYER_URL=
WALRUS_NETWORK=mainnet
WALRUS_ACCOUNT_ID=
# Delegate PRIVATE key (64 hex characters or suiprivkey1...), not the public key.
WALRUS_DELEGATE_KEY=

# Tatum (Sui over gRPC only)
TATUM_API_KEY=
TATUM_NETWORK=mainnet
# Endpoints are taken from Tatum's docs (never defaulted in code). host:port for gRPC.
TATUM_GRPC_ENDPOINT=
# Leave unset: Tatum does not serve Sui JSON-RPC (A8). Setting it adds the JSON-RPC backend as a fallback.
TATUM_JSONRPC_URL=
# Optional: requests per second for the gateway token bucket (default 3).
TATUM_FREE_RPS=

# Server
DATABASE_URL=
# 32+ byte secret used to hash agent tokens and sign sessions/webhooks
BUIRY_SECRET_KEY=
BUIRY_BASE_URL=
# Comma-separated origins allowed for cookie-authenticated writes
BUIRY_ALLOWED_ORIGINS=
# Unset or "console": print sign-in links to the server log (development only; never in production, where email sign-in is refused until a mailer is configured). "memory": in-process (tests only)
BUIRY_MAILER=
# "off" disables plan limits (self-hosting)
BUIRY_ENTITLEMENTS=
# Serve the built dashboard, e.g. apps/dashboard/dist
DASHBOARD_DIR=
PORT=
NODE_ENV=

# OAuth sign-in (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CLI and MCP client
BUIRY_API_URL=
BUIRY_TOKEN=
# JSON array overriding the command `buiry connect` writes, e.g. ["node","<repo>/packages/mcp/dist/bin.js"]
BUIRY_MCP_COMMAND=

# Scripts (optional)
DEMO_PACKAGE_ID=
DEMO_TX_DIGEST=
DEMO_NETWORK=
VALID_UNTIL=
BUIRY_CONTRACT_RELAYER_URL=
SMOKE_TX=
SMOKE_OBJECT=
SMOKE_PACKAGE=
CHROMIUM_PATH=
DASHBOARD_URL=
# Dashboard dev server (Vite) proxy target for /v1, default http://localhost:8787
BUIRY_API=
